# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MySQL via Laragon)
DATABASE_URL="mysql://root:@localhost:3306/lpmq_db"

# JWT Authentication
# Wajib gunakan string acak aman minimal 32 karakter pada deployment produksi
JWT_SECRET="ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_di_lingkungan_nyata"
JWT_EXPIRES_IN="7d"

# File Storage & Upload Security
UPLOAD_DIR="./storage/uploads"
PUBLIC_APP_URL="http://localhost:5173"
# Daftar origin frontend yang diizinkan CORS (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
# Mode pemindai keamanan ClamAV: optional (default dev) | required (default prod) | off
# Pada server yang belum menjalankan daemon ClamAV (port 3310), setel ke 'optional' atau 'off' agar upload berkas tidak ditolak.
AV_SCAN_MODE=optional

# Integrasi Eksternal (Website Existing Kemenag)
# Belum diaktifkan sampai kredensial resmi diberikan
EXISTING_WEBSITE_API_URL=
EXISTING_WEBSITE_API_KEY=
LPMQ_QURAN_USERNAME=
LPMQ_QURAN_TOKEN=

# Mail & Notification Configuration
# Driver: internal (lokal/test) | smtp (mengirim email sungguhan)
# Untuk produksi, set MAIL_DRIVER=smtp dan isi kredensial SMTP di bawah.
MAIL_DRIVER=internal
MAIL_FROM_ADDRESS="no-reply@lpmq.kemenag.go.id"
MAIL_FROM_NAME="LPMQ Kementerian Agama RI"
# Port 587 memakai STARTTLS; port 465 biasanya memakai SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=true
SMTP_TIMEOUT_MS=15000