# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MySQL via Laragon)
DATABASE_URL="mysql://root:@localhost:3306/lpmq_db"

# JWT Authentication
# Wajib gunakan string acak aman minimal 32 karakter pada deployment produksi
JWT_SECRET="ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_di_lingkungan_nyata"
JWT_EXPIRES_IN="7d"

# File Storage
UPLOAD_DIR="./storage/uploads"
PUBLIC_APP_URL="http://localhost:5173"

# Integrasi Eksternal (Website Existing Kemenag)
# Belum diaktifkan sampai kredensial resmi diberikan
EXISTING_WEBSITE_API_URL=
EXISTING_WEBSITE_API_KEY=
LPMQ_QURAN_USERNAME=
LPMQ_QURAN_TOKEN=

# Mail & Notification Configuration
# Driver: internal (default lokal/staging: in-memory, db outbox & terminal log) | smtp (production)
MAIL_DRIVER=internal
MAIL_FROM_ADDRESS="no-reply@lpmq.kemenag.go.id"
MAIL_FROM_NAME="LPMQ Kementerian Agama RI"
# Jika nanti menggunakan SMTP produksi:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
