# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MySQL via Laragon / Staging / Production)
DATABASE_URL="mysql://root:@localhost:3306/lpmq_db"

# JWT Authentication
JWT_SECRET="ganti_dengan_jwt_secret_yang_kuat_dan_aman_minimal_32_karakter"
JWT_EXPIRES_IN="7d"

# File Storage & Upload Security
UPLOAD_DIR="./storage/uploads"
PUBLIC_APP_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
AV_SCAN_MODE=optional

# Integrasi Eksternal (LPMQ Quran)
LPMQ_QURAN_USERNAME=
LPMQ_QURAN_TOKEN=

# Mail & Notification Configuration
# Driver: internal (default lokal/staging: in-memory, db outbox & terminal log) | smtp (production)
MAIL_DRIVER=internal
# Isi dengan alamat sender yang sudah diverifikasi/terdaftar di Brevo.
MAIL_FROM_ADDRESS="no-reply@lpmq.kemenag.go.id"
MAIL_FROM_NAME="LPMQ Kementerian Agama RI"

# Jika nanti menggunakan SMTP produksi:
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=true
SMTP_TIMEOUT_MS=15000

# Mekari Qontak WhatsApp
# Gunakan driver qontak setelah konfigurasi kredensial di backend/.env terisi.
WHATSAPP_DRIVER=mock
QONTAK_ACCESS_TOKEN="FkYkBGNiCctT-gqkTkfXUAy1KqdxjOon6AIRQxWj4aw"
QONTAK_REFRESH_TOKEN="1Oudlxp7BOfrUUKP7M3Lse_XsPGOUZTnpkLA1Eg6l-4"
QONTAK_API_BASE_URL=https://api.mekari.com/qontak/chat/v1
# ID channel/integrasi Qontak yang diberikan: 714428.
QONTAK_CHANNEL_INTEGRATION_ID=714428
# Business User ID akun WhatsApp bisnis; bukan pengganti Channel Integration ID.
QONTAK_WHATSAPP_BUSINESS_USER_ID=307662505766457
# Template OTP approved (Bahasa Indonesia).
QONTAK_TEMPLATE_NAME=konfirmasi_otp_2
QONTAK_TEMPLATE_UUID=0c2b0ddc-C345-42bb-B81b-C7ed6a625345
QONTAK_TIMEOUT_MS=15000
