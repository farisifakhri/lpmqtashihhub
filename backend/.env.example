# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MySQL via Laragon)
DATABASE_URL="mysql://root:@localhost:3306/lpmq_db"

# JWT Authentication
# Wajib gunakan string acak aman minimal 32 karakter pada deployment produksi
JWT_SECRET="ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_di_lingkungan_nyata"
JWT_EXPIRES_IN="7d"

# File Storage
UPLOAD_DIR="./storage/uploads"

# Integrasi Eksternal (Website Existing Kemenag)
# Belum diaktifkan sampai kredensial resmi diberikan
EXISTING_WEBSITE_API_URL=
EXISTING_WEBSITE_API_KEY=
