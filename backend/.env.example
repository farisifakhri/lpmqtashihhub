# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MySQL via Laragon / Staging / Production)
DATABASE_URL="mysql://root:@localhost:3306/lpmq_db"

# JWT Authentication
JWT_SECRET="ganti_dengan_jwt_secret_yang_kuat_dan_aman_minimal_32_karakter"
JWT_EXPIRES_IN="7d"

# File Storage & Upload Security
UPLOAD_DIR="./storage/uploads"
PUBLIC_APP_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
AV_SCAN_MODE=optional

# Integrasi Eksternal (LPMQ Quran)
LPMQ_QURAN_USERNAME=
LPMQ_QURAN_TOKEN=

# Mail & Notification Configuration
# Driver: internal (default lokal/staging: in-memory, db outbox & terminal log) | smtp (production)
MAIL_DRIVER=internal
MAIL_FROM_ADDRESS="no-reply@lpmq.kemenag.go.id"
MAIL_FROM_NAME="LPMQ Kementerian Agama RI"

# Jika nanti menggunakan SMTP produksi:
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
