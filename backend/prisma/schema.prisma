model DocumentNumberSequence {
  id            String   @id @default(uuid())
  sequence_key  String   @unique(map: "doc_num_seq_key") @db.VarChar(100)
  document_type String   @db.VarChar(50)
  year          Int
  last_number   Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("document_number_sequences")
}

model RegulationDocument {
  id              String   @id @default(uuid())
  title           String   @db.VarChar(255)
  category        String   @db.VarChar(100)
  document_number String   @db.VarChar(100)
  file_name       String   @db.VarChar(255)
  storage_path    String   @db.VarChar(500)
  file_size       Int
  mime_type       String   @db.VarChar(100)
  is_published    Boolean  @default(true)
  created_by_id   String?
  created_by      User?    @relation("RegulationCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  updated_by_id   String?
  updated_by      User?    @relation("RegulationUpdatedBy", fields: [updated_by_id], references: [id], onDelete: SetNull)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([category])
  @@index([is_published])
  @@index([created_at])
  @@index([document_number])
  @@map("regulation_documents")
}

model ServiceDocument {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(255)
  category      String   @db.VarChar(100)
  file_name     String   @db.VarChar(255)
  storage_path  String   @db.VarChar(255)
  file_size     Int
  mime_type     String   @db.VarChar(100)
  is_published  Boolean  @default(true)
  created_by_id String?
  updated_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  created_by User? @relation("ServiceDocumentCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  updated_by User? @relation("ServiceDocumentUpdatedBy", fields: [updated_by_id], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([is_published])
  @@index([created_at])
  @@map("service_documents")
}

model InformationGuide {
  id            String                  @id @default(uuid())
  title         String                  @db.VarChar(255)
  section       String                  @default("GUIDE") @db.VarChar(20)
  content_type  String                  @db.VarChar(20)
  content_html  String?                 @db.LongText
  storage_path  String?                 @db.VarChar(500)
  file_name     String?                 @db.VarChar(255)
  file_size     Int?
  mime_type     String?                 @db.VarChar(100)
  is_published  Boolean                 @default(false)
  created_by_id String?
  created_by    User?                   @relation("InformationGuideCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  updated_by_id String?
  updated_by    User?                   @relation("InformationGuideUpdatedBy", fields: [updated_by_id], references: [id], onDelete: SetNull)
  images        InformationGuideImage[]
  created_at    DateTime                @default(now())
  updated_at    DateTime                @updatedAt

  @@index([is_published])
  @@index([section])
  @@index([content_type])
  @@index([created_at])
  @@map("information_guides")
}

model InformationGuideImage {
  id            String           @id @default(uuid())
  guide_id      String
  guide         InformationGuide @relation(fields: [guide_id], references: [id], onDelete: Cascade)
  storage_path  String           @db.VarChar(500)
  file_name     String           @db.VarChar(255)
  file_size     Int
  mime_type     String           @db.VarChar(100)
  created_by_id String?
  created_by    User?            @relation("InformationGuideImageCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at    DateTime         @default(now())

  @@index([guide_id])
  @@map("information_guide_images")
}

enum LandingPageFaqCategory {
