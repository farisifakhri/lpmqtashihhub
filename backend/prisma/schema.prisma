// Prisma Schema untuk Sistem Manajemen Layanan Pentashihan Mushaf Al-Qur'an (LPMQ)
// Berdasarkan ERD v2.2, SRS v2.2, dan SOP Resmi Kementerian Agama RI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. IDENTITY & ACCESS MODULE
// -------------------------------------------------------------

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  whatsapp_number String?
  whatsapp_verified_at DateTime?
  password_hash String
  password_changed_at DateTime?
  nip           String?     @unique
  status UserStatus @default(ACTIVE) // ACTIVE, INACTIVE, SUSPENDED
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  // Relations
  roles                    UserRole[]
  publisher                Publisher?
  password_reset_tokens    PasswordResetToken[]
  verification_assignments VerificationAssignment[]
  verification_assignments_made VerificationAssignment[] @relation("VerificationAssignmentIssuer")
  verification_assignments_revoked VerificationAssignment[] @relation("VerificationAssignmentRevoker")
  verification_documents_created VerificationDocument[] @relation("VerificationDocumentCreator")
  verification_documents_approved VerificationDocument[] @relation("VerificationDocumentApprover")
  physical_master_receipts PhysicalMasterIntake[] @relation("PhysicalMasterIntakeReceiver")
  physical_handovers_sent PhysicalManuscriptHandover[] @relation("PhysicalHandoverSender")
  physical_handovers_received PhysicalManuscriptHandover[] @relation("PhysicalHandoverReceiver")
  team_memberships         TeamMember[]
  teams_led                DistributionTeam[]
  assignments              Assignment[]
  document_signatories     DocumentSignatory[]
  verification_signatures  VerificationDocumentSignatory[] @relation("VerificationSignatures")
  notifications            Notification[]
  audit_logs               AuditLog[]
  status_histories         StatusHistory[]
  core_roster_verifier     CoreTeamRoster[] @relation("CoreRosterVerifier")
  core_roster_distributor  CoreTeamRoster[] @relation("CoreRosterDistributor")
  core_roster_documenter   CoreTeamRoster[] @relation("CoreRosterDocumenter")
  decided_publisher_registrations PublisherRegistration[] @relation("RegistrationDecidedBy")
  publisher_registration   PublisherRegistration?   @relation("RegistrationUserAccount")

  @@map("users")
}

model Role {
  id         String     @id @default(uuid())
  code       RoleCode   @unique
  name       String
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  // Relations
  users      UserRole[]

  @@map("roles")
}

model UserRole {
  id         String   @id @default(uuid())
  user_id    String
  role_id    String
  created_at DateTime @default(now())

  // Relations
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model PasswordResetToken {
  id           String    @id @default(uuid())
  user_id      String
  token_hash   String    @unique
  expires_at   DateTime
  used_at      DateTime?
  requested_ip String?
  created_at   DateTime  @default(now())

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_tokens")
}

// Tim inti berbeda dari DistributionTeam (kelompok pentashih).
model CoreTeamRoster {
  id              String   @id @default(uuid())
  version         Int
  team_number     Int
  verifier_id     String
  distributor_id  String
  documenter_id   String
  created_at      DateTime @default(now())
  verifier        User @relation("CoreRosterVerifier", fields: [verifier_id], references: [id], onDelete: Restrict)
  distributor     User @relation("CoreRosterDistributor", fields: [distributor_id], references: [id], onDelete: Restrict)
  documenter      User @relation("CoreRosterDocumenter", fields: [documenter_id], references: [id], onDelete: Restrict)

  @@unique([version, team_number])
  @@map("core_team_rosters")
}

model CoreTeamRotation {
  id                Int      @id @default(1)
  active_version    Int      @default(1)
  next_team_number  Int      @default(1)
  updated_at        DateTime @updatedAt

  @@map("core_team_rotations")
}

// -------------------------------------------------------------
// 2. PUBLISHER MODULE
// -------------------------------------------------------------

model Publisher {
  id                  String              @id @default(uuid())
  user_id             String?             @unique
  legal_name          String              // Nama Badan Hukum / PT / CV / Yayasan
  entity_type         String              // PT, CV, YAYASAN, LEMBAGA_PEMERINTAH, LAINNYA
  verification_status PublisherVerificationStatus @default(UNVERIFIED) // UNVERIFIED, VERIFIED, REJECTED
  address             String?
  phone               String?
  nomor_induk_penerbit String?             @db.VarChar(50)
  npwp                String?             @db.VarChar(50)
  nib                 String?             @db.VarChar(50)
  profile_edit_allowed Boolean             @default(false)
  profile_edit_granted_by String?
  profile_edit_granted_at DateTime?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  // Relations
  user                User?               @relation(fields: [user_id], references: [id], onDelete: SetNull)
  documents           PublisherDocument[]
  registrations       Registration[]
  registration_submission PublisherRegistration?

  @@map("publishers")
}

model PublisherDocument {
  id            String    @id @default(uuid())
  publisher_id  String
  document_type String    // AKTA_PENDIRIAN, NIB, SK_KEMENKUMHAM, NPWP, SURAT_KUASA
  version       Int       @default(1)
  file_id       String    // Referensi storage private
  status PublisherDocumentStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  notes         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  publisher     Publisher @relation(fields: [publisher_id], references: [id], onDelete: Cascade)

  @@map("publisher_documents")
}

enum PublisherType {
  PERUSAHAAN
  YAYASAN
  LEMBAGA_PEMERINTAH
}

enum PublisherRegistrationStatus {
  DIAJUKAN
  PERLU_PERBAIKAN
  DISETUJUI
  DITOLAK
}

enum PublisherRegistrationDocumentType {
  SURAT_PENDAFTARAN
  AKTA_NOTARIS
  PROFIL
  NPWP
  NIB
  KTP_PENANGGUNG_JAWAB
}

model PublisherRegistration {
  id                String                      @id @default(uuid())
  registration_code String                      @unique(map: "pub_reg_code_key") @db.VarChar(64)
  publisher_type    PublisherType
  name              String                      @db.VarChar(255)
  address           String                      @db.Text
  pic_name          String                      @db.VarChar(255)
  pic_phone         String                      @db.VarChar(50)
  email             String                      @db.VarChar(255)
  npwp              String                      @db.VarChar(50)
  nib               String?                     @db.VarChar(50)
  active_npwp       String?                     @unique(map: "pub_reg_active_npwp_key") @db.VarChar(50)
  active_nib        String?                     @unique(map: "pub_reg_active_nib_key") @db.VarChar(50)
  nomor_induk_penerbit String?                     @db.VarChar(50)
  status            PublisherRegistrationStatus @default(DIAJUKAN)
  reason            String?                     @db.Text
  version           Int                         @default(1)
  decided_at        DateTime?
  decided_by_id     String?
  decided_by        User?                       @relation("RegistrationDecidedBy", fields: [decided_by_id], references: [id], onDelete: SetNull)
  user_id           String?                     @unique(map: "pub_reg_user_id_key")
  user              User?                       @relation("RegistrationUserAccount", fields: [user_id], references: [id], onDelete: SetNull)
  publisher_id      String?                     @unique(map: "pub_reg_publisher_id_key")
  publisher         Publisher?                  @relation(fields: [publisher_id], references: [id], onDelete: SetNull)

  documents         PublisherRegistrationDocument[]
  revision_tokens   PublisherRevisionToken[]

  created_at        DateTime                    @default(now())
  updated_at        DateTime                    @updatedAt

  @@index([status, created_at], map: "pub_reg_status_created_idx")
  @@index([email], map: "pub_reg_email_idx")
  @@map("publisher_registrations")
}

model PublisherRegistrationDocument {
  id                String                            @id @default(uuid())
  registration_id   String
  registration      PublisherRegistration             @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  document_type     PublisherRegistrationDocumentType
  storage_path      String                            @db.VarChar(500)
  original_filename String                            @db.VarChar(255)
  file_size         Int
  file_hash         String                            @db.VarChar(64)
  mime_type         String                            @default("application/pdf") @db.VarChar(100)
  has_links         Boolean                           @default(false)
  detected_links    Json?
  is_replaced       Boolean                           @default(false)
  uploaded_at       DateTime                          @default(now())
  created_at        DateTime                          @default(now())
  updated_at        DateTime                          @updatedAt

  @@index([registration_id, document_type], map: "pub_reg_docs_reg_doc_type_idx")
  @@map("publisher_registration_documents")
}

model PublisherRevisionToken {
  id              String                @id @default(uuid())
  registration_id String
  registration    PublisherRegistration @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  token_hash      String                @unique(map: "pub_rev_tokens_token_hash_key") @db.VarChar(64)
  expires_at      DateTime
  used_at         DateTime?
  created_at      DateTime              @default(now())

  @@index([registration_id, expires_at], map: "pub_rev_tokens_reg_expires_idx")
  @@map("publisher_revision_tokens")
}

// -------------------------------------------------------------
// 3. MASTER DATA MODULE
// -------------------------------------------------------------

model MushafCategory {
  id            String        @id @default(uuid())
  code          String        @unique // MC, MD, MAV, L
  name          String        // Mushaf Cetak, Mushaf Digital, Mushaf Audio/Visual, Lainnya
  display_order Int           @default(0)
  status ActiveStatus @default(ACTIVE) // ACTIVE, INACTIVE
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  // Relations
  service_types ServiceType[]

  @@map("mushaf_categories")
}

model ServiceType {
  id                String         @id @default(uuid())
  category_id       String
  name              String         // Misal: Mushaf Al-Qur'an 30 Juz
  service_kind      String         // CETAK, DIGITAL, AUDIO_VISUAL, BRAILLE
  base_fee          Decimal        @default(0) @db.Decimal(12, 2)
  fee_unit          String         @default("PER_STT") // PER_STT, PER_ITEM
  duration_initial  Int            @default(15) // SLA Awal (Hari Kerja)
  duration_revision Int            @default(7)  // SLA Perbaikan (Hari Kerja)
  duration_dummy    Int            @default(3)  // SLA Dumi/Perpanjangan (Hari Kerja)
  effective_from    DateTime       @default(now())
  effective_to      DateTime?
  status ActiveStatus @default(ACTIVE) // ACTIVE, INACTIVE
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  // Relations
  category          MushafCategory @relation(fields: [category_id], references: [id])
  registrations     Registration[]

  @@map("service_types")
}

model ServiceAddon {
  id             String              @id @default(uuid())
  code           String              @unique // TAR-BRAILLE, TAR-PENDEK, TAR-MUSHAF, ADD-MATERI
  name           String
  fee            Decimal             @db.Decimal(12, 2)
  effective_from DateTime            @default(now())
  effective_to   DateTime?
  status ActiveStatus @default(ACTIVE) // ACTIVE, INACTIVE
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  // Relations
  registrations  RegistrationAddon[]

  @@map("service_addons")
}

model WorkingDay {
  date           DateTime @id @db.Date
  is_working_day Boolean  @default(true)
  description    String?
  source         String   @default("SKB_3_MENTERI")
  updated_by     String?
  updated_at     DateTime @updatedAt

  @@map("working_days")
}

model DistributionTeam {
  id             String        @id @default(uuid())
  name           String        // Misal: Tim Pentashihan Reguler 2026
  decree_no      String        // Nomor SK Kepala LPMQ
  year           Int
  leader_user_id String?
  active_from    DateTime
  active_to      DateTime?
  status ActiveStatus @default(ACTIVE) // ACTIVE, INACTIVE
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  // Relations
  leader         User?         @relation(fields: [leader_user_id], references: [id], onDelete: SetNull)
  members        TeamMember[]
  assignments    Assignment[]

  @@map("distribution_teams")
}

model TeamMember {
  id           String           @id @default(uuid())
  team_id      String
  user_id      String
  role_in_team String           @default("PENTASHIH") // PENTASHIH, PEMBACA_NASKAH, DISTRIBUTOR
  status ActiveStatus @default(ACTIVE)
  created_at   DateTime         @default(now())

  // Relations
  team         DistributionTeam @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@map("team_members")
}

// -------------------------------------------------------------
// 4. REGISTRATION & MANUSCRIPT MODULE
// -------------------------------------------------------------

model Registration {
  id                       String                   @id @default(uuid())
  registration_no          String                   @unique // Misal: REG-2026-09-0001
  publisher_id             String
  service_type_id          String
  title                    String                   // Judul Mushaf / Naskah
  submission_source        String                   @default("PUBLISHER_PORTAL") // PUBLISHER_PORTAL, INTERNAL_ADMIN
  registration_type        String                   @default("NEW") // NEW, EXTENSION
  registration_category    String                   @default("NEW") // NEW, EXTENSION, FOREIGN_MANUSCRIPT
  foreign_metadata         Json?                    // Metadata mushaf luar negeri (negara asal, penerbit luar negeri, no izin edar/impor)
  statement_accepted       Boolean                  @default(false) // Pernyataan keabsahan naskah
  physical_dispatch_status String?                  @default("PENDING") // PENDING, DISPATCHED, RECEIVED
  dispatch_tracking_no     String?
  dispatch_courier         String?
  dispatch_date            DateTime?
  external_sync_status     String                   @default("PENDING") // PENDING, SYNCED, FAILED
  external_sync_id         String?
  external_synced_at       DateTime?
  external_sync_error      String?                  @db.Text
  external_sync_attempts   Int                      @default(0)
  previous_registration_id String?
  apk_url                  String?                  // URL unduhan mushaf digital (harus HTTPS, divalidasi di validator)
  status RegistrationStatus @default(DRAFT)
  stage_entered_at          DateTime                 @default(now())
  // Status: DRAFT, READY_FOR_VERIFICATION, VERIFICATION_ASSIGNED, IN_VERIFICATION,
  // REVISION_REQUIRED, WAITING_VERIFICATION_APPROVAL, VERIFICATION_APPROVED,
  // AWAITING_PAYMENT, PAYMENT_VERIFICATION, WAITING_DISTRIBUTOR_RECEIPT,
  // WAITING_DISTRIBUTION, TASHIH_IN_PROGRESS, READY_FOR_STT, STT_ISSUED,
  // DOCUMENTATION_IN_PROGRESS, COMPLETED, CANCELLED
  fee_sla_snapshot         Json?                    // Snapshot snapshot tarif & SLA saat submit (BR-04, BR-05)
  revision_source          String?                  // VERIFICATION, PHYSICAL_HANDOVER
  core_team_number         Int?
  core_team_version        Int?
  core_verifier_id         String?
  core_distributor_id      String?
  core_documenter_id       String?
  created_at               DateTime                 @default(now())
  updated_at               DateTime                 @updatedAt


  // Relations
  publisher                Publisher                @relation(fields: [publisher_id], references: [id])
  service_type             ServiceType              @relation(fields: [service_type_id], references: [id])
  previous_registration    Registration?            @relation("RegistrationExtensions", fields: [previous_registration_id], references: [id], onDelete: SetNull)
  extensions               Registration[]           @relation("RegistrationExtensions")
  addons                   RegistrationAddon[]
  manuscript_files         ManuscriptFile[]
  manuscripts              Manuscript[]
  status_histories         StatusHistory[]
  verification_assignments VerificationAssignment[]
  verification_documents   VerificationDocument[]
  physical_master_intake   PhysicalMasterIntake?
  physical_handovers       PhysicalManuscriptHandover[]
  payment_records          PaymentRecord[]
  assignments              Assignment[]
  documentation_items      DocumentationItem[]
  official_documents       OfficialDocument[]
  notifications            Notification[]

  @@index([status, stage_entered_at, id])
  @@index([core_verifier_id, status])
  @@index([core_distributor_id, status])
  @@index([core_documenter_id, status])
  @@map("registrations")
}

model RegistrationAddon {
  id              String       @id @default(uuid())
  registration_id String
  addon_id        String
  fee_snapshot    Decimal      @db.Decimal(12, 2)
  quantity        Int          @default(1)
  created_at      DateTime     @default(now())

  // Relations
  registration    Registration @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  addon           ServiceAddon @relation(fields: [addon_id], references: [id])

  @@unique([registration_id, addon_id])
  @@map("registration_addons")
}

model ManuscriptFile {
  id              String       @id @default(uuid())
  registration_id String
  manuscript_id   String?
  type            String       // COVER, SAMPLE_PAGE_1_5, DUMMY, MASTER_COMPLETED
  version         Int          @default(1)
  file_id         String       // Path storage private
  checksum        String?
  file_size       Int?
  mime_type       String?
  created_at      DateTime     @default(now())

  // Relations
  registration    Registration @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  manuscript      Manuscript?  @relation(fields: [manuscript_id], references: [id], onDelete: SetNull)

  @@map("manuscript_files")
}

// -------------------------------------------------------------
// B-01: MODEL PENGIRIMAN BANYAK NASKAH, ITEM, DAN VARIAN
// -------------------------------------------------------------

model JenisNaskahItem {
  id                String       @id @default(uuid())
  code              String       @unique // Misal: JUZ30, YASIN, TERJEMAH, PERKATA, TAFSIR
  name              String       // Nama resmi item
  group_number      Int          // 1, 2, atau 3
  role              ItemRole     @default(DASAR)
  service_kind      ServiceKind  @default(CETAK)
  unit_fee_rate     Int          @default(1) // Pengali unit (misal: Perkata/Tafsir = 2, materi biasa = 1)
  fee_per_unit      Decimal      @default(500000) @db.Decimal(12, 2)
  duration_initial  Int          @default(15) // Mutlak untuk DASAR, penambahan hari (+HK) untuk TAMBAHAN
  duration_revision Int          @default(7)
  duration_dummy    Int          @default(3)
  covers_item_code  String?      // Misal: PERKATA dan TAFSIR mencakup 'TERJEMAH'
  status            ActiveStatus @default(ACTIVE)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  // Relations
  manuscript_items  ManuscriptItem[]

  @@map("jenis_naskah_items")
}

model Manuscript {
  id              String              @id @default(uuid())
  registration_id String
  seq_number      Int                 // Nomor urut naskah dalam pengajuan (1, 2, ..., maks 20)
  title           String              // Judul mushaf / naskah
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  // Relations
  registration    Registration        @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  items           ManuscriptItem[]
  variants        ManuscriptVariant[]
  files           ManuscriptFile[]

  @@unique([registration_id, seq_number])
  @@map("manuscripts")
}

model ManuscriptItem {
  id                     String          @id @default(uuid())
  manuscript_id          String
  item_id                String
  role                   ItemRole        @default(DASAR)
  fee_snapshot           Decimal         @db.Decimal(12, 2)
  initial_days_snapshot  Int             @default(0)
  revision_days_snapshot Int             @default(0)
  dummy_days_snapshot    Int             @default(0)
  created_at             DateTime        @default(now())

  // Relations
  manuscript             Manuscript      @relation(fields: [manuscript_id], references: [id], onDelete: Cascade)
  item                   JenisNaskahItem @relation(fields: [item_id], references: [id])

  @@unique([manuscript_id, item_id])
  @@map("manuscript_items")
}

model ManuscriptVariant {
  id            String     @id @default(uuid())
  manuscript_id String
  ukuran        String     // Format: "Panjang x Lebar" (misal: "21,0 x 29,7")
  oplah         Int        // Bilangan bulat positif
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  // Relations
  manuscript    Manuscript @relation(fields: [manuscript_id], references: [id], onDelete: Cascade)

  @@map("manuscript_variants")
}

model StatusHistory {
  id              String       @id @default(uuid())
  registration_id String
  from_status     String
  to_status       String
  actor_id        String?
  notes           String?
  changed_at      DateTime     @default(now())

  // Relations
  registration    Registration @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  actor           User?        @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@map("status_histories")
}

// -------------------------------------------------------------
// 5. VERIFICATION & BILLING MODULE
// -------------------------------------------------------------

model VerificationAssignment {
  id              String       @id @default(uuid())
  registration_id String
  verifier_id     String
  assigned_by_id  String?
  started_at      DateTime?
  due_at          DateTime?
  assignment_notes String?
  status VerificationAssignmentStatus @default(ASSIGNED) // ASSIGNED, IN_PROGRESS, WAITING_APPROVAL, WAITING_SIGNATURE, READY_TO_SEND, COMPLETED, REVOKED
  decision        VerificationDecision? // PASSED, REVISION_REQUIRED, REJECTED
  notes           String?
  return_reason   String?   @db.Text   // Alasan pengembalian draft oleh Kepala LPMQ
  revoked_at      DateTime?
  revoked_by_id   String?
  revocation_reason String? @db.Text   // Alasan pencabutan penugasan oleh Kepala LPMQ
  review_submitted_at DateTime?
  assigned_at     DateTime     @default(now())
  completed_at    DateTime?

  // Relations
  registration    Registration @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  verifier        User         @relation(fields: [verifier_id], references: [id])
  assigned_by     User?        @relation("VerificationAssignmentIssuer", fields: [assigned_by_id], references: [id], onDelete: SetNull)
  revoked_by      User?        @relation("VerificationAssignmentRevoker", fields: [revoked_by_id], references: [id], onDelete: SetNull)
  documents       VerificationDocument[]

  @@index([registration_id, status])
  @@map("verification_assignments")
}

model PhysicalMasterIntake {
  id              String @id @default(uuid())
  registration_id String @unique
  format          String @default("A4")
  binding_method  String @default("PER_JUZ")
  volume_count    Int?
  sent_at         DateTime?
  delivery_method String?
  notes           String?
  status          PhysicalMasterIntakeStatus @default(PENDING)
  received_by_id  String?
  received_at     DateTime?
  condition       String?
  receipt_no      String? @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  registration    Registration @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  received_by     User? @relation("PhysicalMasterIntakeReceiver", fields: [received_by_id], references: [id], onDelete: SetNull)

  @@map("physical_master_intakes")
}

model VerificationDocument {
  id              String @id @default(uuid())
  qr_token        String @unique @default(uuid())
  registration_id String
  assignment_id   String?
  document_type   VerificationDocumentType
  document_no     String? @unique
  version         Int @default(1)
  status          VerificationDocumentStatus @default(DRAFT)
  content_snapshot Json?
  file_id         String?
  created_by_id   String
  approved_by_id  String?
  approved_at     DateTime?
  signature_status DocumentSignatureStatus @default(NOT_REQUESTED)
  signed_at       DateTime?
  sent_at         DateTime?
  sent_channel    String?
  sent_to         String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  registration    Registration @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  assignment      VerificationAssignment? @relation(fields: [assignment_id], references: [id], onDelete: SetNull)
  created_by      User @relation("VerificationDocumentCreator", fields: [created_by_id], references: [id])
  approved_by     User? @relation("VerificationDocumentApprover", fields: [approved_by_id], references: [id], onDelete: SetNull)
  signatories     VerificationDocumentSignatory[]

  @@unique([registration_id, document_type, version])
  @@map("verification_documents")
}

model VerificationDocumentSignatory {
  id                     String                  @id @default(uuid())
  document_id            String
  signer_user_id         String
  name_position_snapshot String
  sign_order             Int                     @default(1)
  method                 String                  @default("INTERNAL_APPROVAL") // Persetujuan internal; bukan TTE tersertifikasi
  status                 SigningStatus           @default(PENDING) // PENDING, SIGNED, REJECTED
  signed_at              DateTime?
  document_hash          String?
  external_signature_id  String?
  failure_reason         String?
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt

  document               VerificationDocument    @relation(fields: [document_id], references: [id], onDelete: Cascade)
  signer                 User                    @relation("VerificationSignatures", fields: [signer_user_id], references: [id])

  @@index([document_id, signer_user_id])
  @@map("verification_document_signatories")
}

model PhysicalManuscriptHandover {
  id              String @id @default(uuid())
  registration_id String
  from_user_id    String
  to_user_id      String
  stage           String @default("VERIFICATION_TO_DISTRIBUTION")
  receipt_no      String? @unique
  condition       String?
  volume_count    Int?
  handed_over_at  DateTime?
  received_at     DateTime?
  tashih_due_at   DateTime?
  notes           String?
  status          PhysicalHandoverStatus @default(PENDING)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  registration    Registration @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  from_user       User @relation("PhysicalHandoverSender", fields: [from_user_id], references: [id])
  to_user         User @relation("PhysicalHandoverReceiver", fields: [to_user_id], references: [id])

  @@index([registration_id, status])
  @@map("physical_manuscript_handovers")
}

model PaymentRecord {
  id              String       @id @default(uuid())
  registration_id String
  billing_no      String       @unique
  amount          Decimal      @db.Decimal(12, 2)
  status PaymentStatus @default(UNPAID) // UNPAID, PAID, VERIFIED, EXPIRED, CANCELLED
  receipt_file_id String?
  provider        String       @default("MANUAL") // MANUAL, SIMPONI
  external_ref    String?      // NTPN / referensi bank
  sync_status     String       @default("NOT_SYNCED")
  paid_at         DateTime?
  verified_at     DateTime?
  expires_at      DateTime?
  rejection_reason String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  // Relations
  registration    Registration @relation(fields: [registration_id], references: [id], onDelete: Cascade)

  @@map("payment_records")
}

// -------------------------------------------------------------
// 6. DISTRIBUTION & TASHIH MODULE
// -------------------------------------------------------------

model Assignment {
  id              String            @id @default(uuid())
  registration_id String
  team_id         String?
  assignee_id     String
  stage AssignmentStage            // INITIAL, REVISION, DUMMY
  iteration       Int               @default(1)
  due_at          DateTime?
  status AssignmentStatus @default(ASSIGNED) // ASSIGNED, IN_PROGRESS, COMPLETED, OVERDUE
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  // Relations
  registration    Registration      @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  team            DistributionTeam? @relation(fields: [team_id], references: [id], onDelete: SetNull)
  assignee        User              @relation(fields: [assignee_id], references: [id])
  reviews         TashihReview[]
  juz_items       AssignmentJuz[]

  @@map("assignments")
}

model AssignmentJuz {
  id            String       @id @default(uuid())
  assignment_id String
  juz_number    Int
  result        ReviewResult?
  notes         String?      @db.Text
  completed_at  DateTime?
  updated_at    DateTime     @updatedAt

  assignment    Assignment   @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@unique([assignment_id, juz_number])
  @@map("assignment_juz")
}

model TashihReview {
  id            String     @id @default(uuid())
  assignment_id String
  result ReviewResult     // PASSED, REVISION_REQUIRED, REJECTED
  notes         String?
  completed_at  DateTime   @default(now())

  // Relations
  assignment    Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@map("tashih_reviews")
}

// -------------------------------------------------------------
// 7. DOCUMENTATION & OFFICIAL DOCUMENTS MODULE
// -------------------------------------------------------------

model DocumentationItem {
  id              String       @id @default(uuid())
  registration_id String
  item_type       String       // PHYSICAL_EXEMPLAR_TARGET, PHYSICAL_EXEMPLAR_RECEIVED, ARCHIVE_MASTER, NOT_APPLICABLE
  required        Boolean      @default(true)
  status DocumentationStatus @default(PENDING) // PENDING, RECEIVED, WAIVED, NOT_APPLICABLE
  quantity_target Int          @default(5)
  quantity_actual Int          @default(0)
  file_id         String?
  version         Int          @default(1)
  checked_by      String?
  checked_at      DateTime?

  // Relations
  registration    Registration @relation(fields: [registration_id], references: [id], onDelete: Cascade)

  @@map("documentation_items")
}

model OfficialDocument {
  content_snapshot Json?
  id              String              @id @default(uuid())
  registration_id String
  document_type   String              // BERITA_ACARA_TASHIH, SURAT_TANDA_TASHIH
  document_no     String              @unique
  version         Int                 @default(1)
  status OfficialDocumentStatus @default(DRAFT) // DRAFT, SIGNED, ISSUED, REVOKED, EXPIRED
  qr_token        String              @unique @default(uuid())
  file_id         String?
  issued_at       DateTime?
  valid_until     DateTime?           // BR-20: 2 tahun untuk Surat Tanda Tashih
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  // Relations
  registration    Registration        @relation(fields: [registration_id], references: [id], onDelete: Cascade)
  signatories     DocumentSignatory[]

  @@map("official_documents")
}

model DocumentSignatory {
  id                     String           @id @default(uuid())
  official_document_id   String
  signer_user_id         String
  name_position_snapshot String           // Nama dan jabatan saat ttd (misal: Kepala LPMQ)
  method                 String           @default("DIGITAL") // DIGITAL, BSRE, MANUAL
  signing_status SigningStatus @default(PENDING) // PENDING, SIGNED, REJECTED
  signed_at              DateTime?
  external_signature_id  String?

  // Relations
  official_document      OfficialDocument @relation(fields: [official_document_id], references: [id], onDelete: Cascade)
  signer                 User             @relation(fields: [signer_user_id], references: [id])

  @@map("document_signatories")
}

// -------------------------------------------------------------
// 8. AUDIT & NOTIFICATION MODULE
// -------------------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid())
  actor_id     String?
  action       String   // CREATE, UPDATE, STATUS_TRANSITION, APPROVE, REJECT, LOGIN, DOWNLOAD
  subject_type String   // Registration, PaymentRecord, OfficialDocument, etc.
  subject_id   String?
  before_json  Json?
  after_json   Json?
  ip_address   String?
  user_agent   String?
  created_at   DateTime @default(now())

  // Relations
  actor        User?    @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Notification {
  id              String        @id @default(uuid())
  user_id         String
  registration_id String?
  type            String        // STATUS_UPDATE, ASSIGNMENT, PAYMENT_CONFIRMED, DOCUMENT_ISSUED
  title           String
  payload         Json?
  read_at         DateTime?
  created_at      DateTime      @default(now())

  // Relations
  user            User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  registration    Registration? @relation(fields: [registration_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model StoredFile {
  id         String   @id @default(uuid())
  owner_id   String
  mime_type  String
  file_size  Int
  checksum   String
  created_at DateTime @default(now())

  @@index([owner_id])
  @@map("stored_files")
}

model EmailOutbox {
  id                  String            @id @default(uuid())
  registration_id     String?
  document_id         String?
  idempotency_key     String            @unique
  recipient_email     String
  recipient_name      String?
  subject             String
  template            String
  payload             Json?
  attachments_json    Json?
  provider            String            @default("SYSTEM")
  provider_message_id String?
  status              EmailOutboxStatus @default(QUEUED)
  retry_count         Int               @default(0)
  max_retries         Int               @default(3)
  failure_reason      String?           @db.Text
  queued_at           DateTime          @default(now())
  sent_at             DateTime?
  last_attempt_at     DateTime?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  @@index([registration_id, status])
  @@index([idempotency_key])
  @@map("email_outbox")
}

